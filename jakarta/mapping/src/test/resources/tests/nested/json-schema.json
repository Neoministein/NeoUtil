{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "OrderHeader": {
      "type": "object",
      "properties": {
        "Customer": {
          "type": "string"
        },
        "Id": {
          "type": "string"
        },
        "Empty": {
          "type": "string"
        }
      },
      "required": [
        "Customer",
        "Id",
        "Empty"
      ]
    },
    "Line": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Product": {
            "type": "string"
          },
          "count": {
            "type": "string"
          },
          "packaging": {
            "type": "string"
          },
          "Date": {
            "type": "string"
          },
          "Lot": {
            "type": "string"
          }
        },
        "required": [
          "Product",
          "count",
          "packaging",
          "Date",
          "Lot"
        ]
      }
    }
  },
  "required": [
    "OrderHeader",
    "Line"
  ]
}